{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default desktop capability for Zomboid Mod Downloader",
  "windows": ["main"],
  "webviews": ["main", "workshop-browser"],
  "remote": {
    "urls": ["https://steamcommunity.com/*", "https://*.steamcommunity.com/*"]
  },
  "permissions": [
    "core:default",
    "opener:default"
  ]
}
