{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Zomboid Mod Downloader",
  "version": "2.0.0",
  "identifier": "io.zomboidmoddownloader.desktop",
  "build": {
    "beforeDevCommand": "npm.cmd run dev",
    "beforeBuildCommand": "npm.cmd run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist-tauri-ui"
  },
  "app": {
    "windows": [
      {
        "title": "Zomboid Mod Downloader",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 720,
        "create": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Zomboid Mod Downloader",
    "category": "Utility",
    "shortDescription": "Project Zomboid Steam Workshop downloader",
    "longDescription": "Browse, queue, and download Project Zomboid Steam Workshop mods through SteamCMD."
  }
}
